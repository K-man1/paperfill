# Copy to .env on the server and fill in real values. NEVER commit .env.
#   cp .env.example .env && nano .env

# Port gunicorn binds to. On Nest run `nest get-port` and paste the number here.
PORT=8080

# Flask session signing key. Generate one:  python -c "import secrets;print(secrets.token_hex(32))"
SECRET_KEY=

# Session cookie is HTTPS-only by default. Set to 0 ONLY for local development
# over plain http://localhost, where the browser never sends a Secure cookie
# back and sign-in appears to do nothing. Never 0 in production.
# COOKIE_SECURE=1

# Email/password sign-in. Off by default so production launches Google-only;
# /login's POST, /signup and /verify/<token> all 404 while it's off. Turn it on
# only once SMTP_HOST and friends are configured, or nobody can verify.
# EMAIL_AUTH=1

# Comma-separated emails that get the "admin" role (and with it /admin and Pro
# features). Defaults to the owner's address.
# ADMIN_EMAILS=you@example.com

# LLM provider key. Points at any OpenAI-compatible API. Default base URL is
# the free Hack Club AI proxy (no card needed), so this is the only value you
# need to set to get started.
AI_API_KEY=
# Optional overrides — leave unset to use the Hack Club proxy defaults.
# AI_BASE_URL=https://ai.hackclub.com/proxy/v1
# AI_MODEL=qwen/qwen3-32b

# Answer-space detector. "deterministic" (default) = preprocess.py; set
# "multimodal" to route uploads through the vision + anchor-bridge path
# (multimodal_preprocess.py). Also selectable per-upload via the `detector`
# form field.
# PAPERFILL_DETECTOR=deterministic
# MULTIMODAL_MODEL=openai/gpt-4o   # vision model for the multimodal detector
# OCR_MODEL=                       # scanned-page detector; needs bbox grounding.
#                                  # Inherits VISION_MODEL when unset.
# MULTIMODAL_INPUT=image           # "image" (render pages) or "pdf" (upload doc)
# MULTIMODAL_DPI=150               # render DPI when MULTIMODAL_INPUT=image

# Supabase — backs the admin dashboard (sign-ins, filled assignments, device
# count). Shared across all gunicorn workers so the numbers are consistent.
# SUPABASE_URL is the project URL; SUPABASE_SECRET_KEY is a *secret* API key
# (Supabase Dashboard → Project Settings → API keys → Secret keys, sb_secret_…).
# Keep it secret — it bypasses Row Level Security. NEVER put the real value
# here; this file is committed. Put it only in .env. If either is blank the
# dashboard just shows empty data; nothing else breaks.
SUPABASE_URL=https://oxpuwpeasjxasbhijeib.supabase.co
SUPABASE_SECRET_KEY=

# ---- Pro tier / Stripe billing ----
# Pro is sold via a Stripe Payment Link. To go live:
#   1. Stripe Dashboard → Payment Links → create a link for the Pro product
#      ($5/yr). Paste the URL below. The upgrade buttons go dark until it's set.
#   2. Stripe Dashboard → Developers → Webhooks → add an endpoint pointing to
#      https://<your-domain>/stripe/webhook, subscribe to
#      "checkout.session.completed" AND "customer.subscription.deleted", and
#      paste its signing secret (whsec_…) into STRIPE_WEBHOOK_SECRET. Without
#      the secret the webhook rejects everything, so paid users won't
#      auto-upgrade (you can still grant Pro from /admin).
# The buyer's checkout email is matched to their account to flip is_pro, so the
# pricing page pre-fills it with the signed-in user's email.
STRIPE_PAYMENT_LINK=
STRIPE_WEBHOOK_SECRET=
# Display price on the pricing page (cosmetic only — set the real amount in Stripe).
# PRO_PRICE=$10/yr
# Secret key (sk_...) from Stripe Dashboard → Developers → API keys. Only used
# by the "Cancel subscription" button in Settings to actually stop billing via
# Stripe's API. Without it, cancelling just tells the user to email support —
# nothing breaks, but cancellation isn't automatic.
STRIPE_SECRET_KEY=

# ---- Pro tier / Whop billing ----
# Whop is the path that's actually live; the Stripe block above was wired up but
# never configured. If both are set, the pricing page prefers Whop.
#   1. The plan's purchase_url (`whop plans list`) goes in WHOP_CHECKOUT_LINK.
#      The upgrade button stays dark until it's set.
#   2. Creating the webhook needs an API-key login, not the OAuth one:
#        whop login --method api-key --api-key whop_xxx
#        whop webhooks create --resource_id <biz_id> \
#          --url https://<your-domain>/whop/webhook \
#          --events membership.went_valid --events membership.went_invalid \
#          --events payment.succeeded
#      Paste the `ws_…` secret it prints into WHOP_WEBHOOK_SECRET. Without the
#      secret the endpoint rejects everything, so paid users won't auto-upgrade
#      (you can still grant Pro from /admin).
# The buyer's checkout email is matched to their account to flip is_pro, so the
# pricing page pre-fills it with the signed-in user's email.
WHOP_CHECKOUT_LINK=
WHOP_WEBHOOK_SECRET=

# ---- What Pro actually buys ----
# 1. Unmetered AI. Free accounts get this many AI credits per UTC day
#    (counted in usage.json); Pro is unmetered. CREDIT_TOKENS sets how many
#    model tokens one credit buys — roughly 2 credits per filled page.
# FREE_DAILY_CREDITS=20
# CREDIT_TOKENS=1000
# 2. A better model. Pro fills/vision calls use these instead of AI_MODEL /
#    VISION_MODEL. Leave unset and Pro silently gets the same model as Free —
#    set them, or drop that promise from the pricing page.
# AI_MODEL_PRO=google/gemini-3.5-flash
# VISION_MODEL_PRO=google/gemini-3.5-flash
# 3. Handwriting fonts — no config; gated on the Pro tier in code.
