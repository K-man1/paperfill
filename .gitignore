# Secrets — never commit; recreate directly on the server
.env
secret_key.txt

# Generated at runtime — regenerated on the server, don't ship
uploads/
outputs/
# PDFs users attached to problem reports — real documents, never commit
reports/
user_password.txt
# Per-user daily AI credit counts (see usage.py) — runtime state, resets daily
usage.json
# AI price list (see costs.py) — per-deployment config, edited from /admin
ai_rates.json
# Ad config, edited from /admin (see get_ads_enabled / VAST_TAGS_PATH in app.py)
ads_enabled.txt
vast_tags.txt

# User-built handwriting fonts (created at runtime, per deployment)
handwriting/fonts/

# Python / OS cruft
__pycache__/
*.pyc
.DS_Store
venv/
.venv/

# Local Claude Code config and agents — personal tooling, not project source
.claude/
# Scratch runs of tools/ab_compare.py over a real worksheet. The curated
# sample set in docs/ab-comparison/ IS committed (it's the evidence for the
# README's accuracy claim); these one-off dumps are not.
docs/ab-comparison/dle*.pdf
docs/ab-comparison/dle*.png
docs/ab-comparison/dle_p01*

# Signup Pro toggle, edited from /admin (see get_auto_pro in app.py)
auto_pro.txt
