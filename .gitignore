# Secrets — never commit; recreate directly on the server
.env
secret_key.txt

# Generated at runtime — regenerated on the server, don't ship
uploads/
outputs/
# PDFs users attached to problem reports — real documents, never commit
reports/
signin_log.json
activity_log.json
devices.json
user_password.txt
# Per-user daily upload counts (see usage.py) — runtime state, resets daily
usage.json
# AI price list (see costs.py) — per-deployment config, edited from /admin
ai_rates.json
ads_enabled.txt
adsense_client.txt
adsense_slot.txt

# User-built handwriting fonts (created at runtime, per deployment)
handwriting/fonts/

# Python / OS cruft
__pycache__/
*.pyc
.DS_Store
venv/
.venv/
ab_samples/dle*.pdf
ab_samples/dle*.png
ab_samples/dle_p01*
